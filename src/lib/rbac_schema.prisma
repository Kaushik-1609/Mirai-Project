// ==============================================================================
// PRISMA SCHEMA: THREE-ROLE ROLE BASED ACCESS CONTROL (MSOT LEARN)
// Roles: ADMIN, FACULTY, STUDENT
// Models: Profile, Question, Submission, UserStat, AuditLog
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  FACULTY
  STUDENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ActivityType {
  DAILY_TRIAL
  WEEKEND_LAB
  GENERAL
}

enum QuestionDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Profile {
  id              String         @id @default(uuid())
  email           String         @unique
  displayName     String         @map("display_name")
  username        String         @unique
  role            UserRole       @default(STUDENT)
  avatar          String         @default("⚔️")
  status          AccountStatus  @default(ACTIVE)
  studentId       String?        @map("student_id")
  year            String?        @default("2nd Year")
  semester        String?        @default("Semester 4")
  section         String?        @default("Section Alpha")
  branch          String?        @default("Computer Science & Engineering (CSE)")
  phone           String?
  track           String?        @default("C++ Algorithms & DSA")
  anonymousMode   Boolean        @default(false) @map("anonymous_mode")
  anonymousAlias  String?        @map("anonymous_alias")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  questions       Question[]     @relation("CreatorQuestions")
  submissions     Submission[]
  stats           UserStat?
  auditLogs       AuditLog[]     @relation("ActorAuditLogs")

  @@map("profiles")
}

model Question {
  id              String              @id @default(uuid())
  title           String
  description     String?
  options         Json                // Array of option objects
  correctAnswer   String              @map("correct_answer")
  explanation     String?
  difficulty      QuestionDifficulty  @default(BEGINNER)
  category        String              @default("C++ DSA")
  activityType    ActivityType        @default(DAILY_TRIAL) @map("activity_type")
  isPublished     Boolean             @default(true) @map("is_published")
  creatorId       String?             @map("creator_id")
  creatorEmail    String?             @map("creator_email")
  creatorName     String?             @map("creator_name")
  xpReward        Int                 @default(15) @map("xp_reward")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  creator         Profile?            @relation("CreatorQuestions", fields: [creatorId], references: [id])
  submissions     Submission[]

  @@map("questions")
}

model Submission {
  id              String       @id @default(uuid())
  studentId       String       @map("student_id")
  questionId      String       @map("question_id")
  submittedAnswer String       @map("submitted_answer")
  isCorrect       Boolean      @map("is_correct")
  xpAwarded       Int          @default(0) @map("xp_awarded")
  submittedAt     DateTime     @default(now()) @map("submitted_at")

  student         Profile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question        Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

model UserStat {
  id              String       @id @default(uuid())
  userId          String       @unique @map("user_id")
  xp              Int          @default(0)
  streak          Int          @default(1)
  freezeShields   Int          @default(2) @map("freeze_shields")
  questionsSolved Int          @default(0) @map("questions_solved")
  timeSpentMins   Int          @default(0) @map("time_spent_mins")
  lastActive      DateTime     @default(now()) @map("last_active")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  profile         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model AuditLog {
  id              String       @id @default(uuid())
  actorId         String?      @map("actor_id")
  actorEmail      String       @map("actor_email")
  actorRole       UserRole     @map("actor_role")
  action          String
  targetType      String?      @map("target_type")
  targetId        String?      @map("target_id")
  details         Json?
  ipHint          String?      @map("ip_hint")
  createdAt       DateTime     @default(now()) @map("created_at")

  actor           Profile?     @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@map("audit_logs")
}

model Assignment {
  id              String       @id @default(uuid())
  creatorId       String?      @map("creator_id")
  creatorName     String?      @map("creator_name")
  creatorEmail    String?      @map("creator_email")
  title           String
  description     String?
  subject         String       @default("C++ DSA")
  topic           String?
  deadline        DateTime?
  xpReward        Int          @default(50) @map("xp_reward")
  maxMarks        Int          @default(100) @map("max_marks")
  targetSection   String       @default("ALL") @map("target_section")
  resourceUrl     String?      @map("resource_url")
  isPublished     Boolean      @default(true) @map("is_published")
  status          String       @default("ACTIVE")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  submissions     AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id                String       @id @default(uuid())
  assignmentId      String       @map("assignment_id")
  studentId         String       @map("student_id")
  studentName       String?      @map("student_name")
  studentEmail      String?      @map("student_email")
  submissionContent String       @map("submission_content")
  fileUrl           String?      @map("file_url")
  status            String       @default("SUBMITTED")
  gradeScore        Int?         @map("grade_score")
  gradeXp           Int          @default(0) @map("grade_xp")
  feedback          String?
  gradedBy          String?      @map("graded_by")
  gradedByName      String?      @map("graded_by_name")
  submittedAt       DateTime     @default(now()) @map("submitted_at")
  gradedAt          DateTime?    @map("graded_at")

  assignment        Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model StudentInactivityReason {
  id              String       @id @default(uuid())
  studentId       String       @map("student_id")
  studentName     String?      @map("student_name")
  studentEmail    String?      @map("student_email")
  category        String
  reasonText      String       @map("reason_text")
  dateFrom        DateTime?    @map("date_from")
  dateTo          DateTime?    @map("date_to")
  status          String       @default("PENDING")
  facultyResponse String?      @map("faculty_response")
  respondedByName String?      @map("responded_by_name")
  respondedByEmail String?     @map("responded_by_email")
  respondedAt     DateTime?    @map("responded_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@map("student_inactivity_reasons")
}

model StudentMessage {
  id                  String       @id @default(uuid())
  senderId            String       @map("sender_id")
  senderName          String       @map("sender_name")
  senderEmail         String       @map("sender_email")
  senderRole          UserRole     @map("sender_role")
  receiverId          String       @map("receiver_id")
  receiverName        String       @map("receiver_name")
  receiverEmail       String       @map("receiver_email")
  subject             String?
  content             String
  relatedAssignmentId String?      @map("related_assignment_id")
  relatedReasonId     String?      @map("related_reason_id")
  inReplyTo           String?      @map("in_reply_to")
  isRead              Boolean      @default(false) @map("is_read")
  createdAt           DateTime     @default(now()) @map("created_at")

  @@map("student_messages")
}

